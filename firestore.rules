rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated as the designated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "qdVg8nA0dVaA7SxE9QrIRzOXiz23" ||
        request.auth.token.email == "admin@maakarni.com" ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // Public website can READ catalog, content & settings; only admin can WRITE
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /brands/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{document=**} {
      allow read: if true;
      allow create: if true; // Public customers can submit reviews
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminUsers/{userId} {
      allow read, write: if isAdmin();
    }

    // ImgBB media catalogue (admin panel only — customer site never needs it)
    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    match /activityLog/{logId} {
      allow read, write: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow read: if isAdmin();
      allow create: if true; // customer website contact forms
      allow update, delete: if isAdmin();
    }

    // Customer Users collection and their subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /addresses/{addressId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /orders/{orderId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /rewards/{rewardId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /couponUsage/{couponCode} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
